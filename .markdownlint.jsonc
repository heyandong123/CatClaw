{
  // markdownlint 配置 —— 声明本项目遵守哪些规则。
  //
  // 没有这个文件时，所有警告都来自 markdownlint 的内置默认值：
  // 换个编辑器或 lint 版本结果就会变，别人（包括未来的自己）也无从判断
  // 某条警告是"作者疏忽"还是"有意为之"。下面两条是明确的有意豁免。

  // MD013 line-length：行长度上限。默认 80 个字符，这个数字是为英文定的 ——
  // 中文一个字就是一个字，同样的 80 字符承载的信息量远大于英文单词，
  // 正常的中文句子几乎必然超标。强行在 80 字符处截断，可读性反而更差。
  // 中文项目普遍关闭此规则。
  "MD013": false,

  // MD036 no-emphasis-as-heading：禁止用加粗代替标题。
  // README 第 3 行的加粗副标题是有意为之 —— 它是标语，不是章节。
  // 改成真正的标题会让它进入 GitHub 自动生成的目录（TOC），反而不对。
  "MD036": false
}
